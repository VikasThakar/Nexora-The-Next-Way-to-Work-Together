<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- Authorization and isolation tests, runnable alone as a fast CI gate. -->
        <testsuite name="Security">
            <directory>tests/Security</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="ALLOW_PUBLIC_REGISTRATION" value="false"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Pinned so the suite tests the DEFAULT driver rather than whatever a
             developer has in .env. Without this, AI_CODE_DRIVER=claude_code
             locally makes ApplyModeTest fail against a correct application. -->
        <env name="AI_CODE_DRIVER" value="unavailable"/>
        <!-- Pinned for the same reason. Production reports in Europe/Stockholm;
             a test that needs a zone sets it itself. -->
        <env name="WORKSPACE_DEFAULT_TIMEZONE" value="UTC"/>
        <!-- The remote MCP server's defaults: on, the supported AI clients
             only, and no Passport keys from .env (tests generate their own;
             see Tests\Support\InteractsWithMcp). -->
        <env name="MCP_SERVER_ENABLED" value="true"/>
        <env name="MCP_REDIRECT_DOMAINS" value="https://claude.ai,https://claude.com,https://chatgpt.com,http://localhost"/>
        <env name="MCP_RATE_LIMIT" value="60"/>
        <env name="PASSPORT_PRIVATE_KEY" value=""/>
        <env name="PASSPORT_PUBLIC_KEY" value=""/>
    </php>
</phpunit>
