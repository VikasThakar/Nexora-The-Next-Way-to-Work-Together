###############################################################################
# Application
###############################################################################

APP_NAME="Aqueduct Workspace"
APP_ENV=local
# Generate with: php artisan key:generate
# On Railway, set this as a service variable; never commit a real key.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

# Cost factor for password hashing. Leave at 12 in production.
BCRYPT_ROUNDS=12

###############################################################################
# Workspace
###############################################################################

WORKSPACE_NAME="Aqueduct Workspace"
WORKSPACE_SHORT_NAME="Aqueduct"
WORKSPACE_DEFAULT_TIMEZONE=UTC

# Self-service registration is off by default: this is an internal tool and
# accounts are created by an administrator. A self-registered account gets the
# least privileged role and no board access.
ALLOW_PUBLIC_REGISTRATION=false

# The workspace Activity feed (/activity). Leave on: it is the only history of
# board, membership and documentation changes in the application, and the
# Activity screen is empty without it. Turning it off stops new activity being
# written and leaves what is already there readable — it exists for bulk
# imports and data migrations, not as a feature switch. Ticket history
# (`ticket_events`, the per-ticket timeline and every flow metric behind the
# statistics screens) is written separately and is NOT affected by this.
ACTIVITY_LOGGER_ENABLED=true

###############################################################################
# Database (MySQL)
###############################################################################

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aqueduct_workspace
DB_USERNAME=root
DB_PASSWORD=

# On Railway, reference the MySQL service instead of the values above:
#   DB_HOST=${{MySQL.MYSQLHOST}}
#   DB_PORT=${{MySQL.MYSQLPORT}}
#   DB_DATABASE=${{MySQL.MYSQLDATABASE}}
#   DB_USERNAME=${{MySQL.MYSQLUSER}}
#   DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

###############################################################################
# Sessions
###############################################################################

# `database` keeps sessions durable across container restarts without needing
# Redis. Switch to `redis` once a Redis service is attached.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Must be true in production so the session cookie is HTTPS-only.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

###############################################################################
# Cache and queue
###############################################################################

CACHE_STORE=database
# CACHE_PREFIX=

# `database` works out of the box. Set to `redis` when a Redis service exists.
QUEUE_CONNECTION=database

###############################################################################
# Redis (optional; required only when CACHE_STORE/QUEUE_CONNECTION are `redis`)
###############################################################################

# `predis` needs no PHP extension and is installed. Use `phpredis` if the
# extension is available in the runtime image.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# On Railway: REDIS_URL=${{Redis.REDIS_URL}}
# REDIS_URL=

###############################################################################
# Filesystem / object storage
###############################################################################

# Local disk is ephemeral on Railway: every deploy replaces the container and
# uploaded files would be lost. Use S3-compatible storage in every deployed
# environment.
# Where uploaded attachments are kept.
#
#   local    development only. The container filesystem is replaced on every
#            deploy, so the production boot check refuses this outright.
#   volume   a persistent volume mounted at ATTACHMENT_VOLUME_PATH. No account
#            and no credentials — the free option on Railway, Fly or a VPS.
#   s3       an S3-compatible bucket, configured with the AWS_* block below.
#
FILESYSTEM_DISK=local

# Mount point for the `volume` disk. Must be a real mounted volume in
# production: the boot check stats it and refuses to start if it is an ordinary
# container directory, because uploads written there vanish at the next deploy.
ATTACHMENT_VOLUME_PATH=/data

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Set for non-AWS S3-compatible providers (Cloudflare R2, MinIO, Backblaze B2).
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

###############################################################################
# Ticket attachments
###############################################################################

# Defaults to FILESYSTEM_DISK. In production this MUST be an S3-compatible disk:
# the application refuses to boot otherwise, because the Railway container
# filesystem is replaced on every deploy and uploads would silently vanish.
# ATTACHMENT_DISK=s3

# Lifetime of a generated download link. Short on purpose: the signed URL
# carries no further authorization once issued.
ATTACHMENT_URL_TTL_MINUTES=5

ATTACHMENT_MAX_SIZE_KB=10240
ATTACHMENT_MAX_PER_OWNER=20

# Attachments hang off tickets, comments and documentation pages. They carry no
# visibility flag of their own: each one inherits it from whatever it is
# attached to, so a file on an internal note is as private as the note.

# Livewire buffers uploads before they are stored. On Railway that buffer must
# not be the local disk either, or a file can disappear between the upload and
# the save.
# LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=s3

###############################################################################
# Mail (password reset links)
###############################################################################

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="workspace@example.com"
MAIL_FROM_NAME="${WORKSPACE_NAME}"

###############################################################################
# Logging
###############################################################################

# Use `stderr` on Railway so log lines are captured by the platform.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# Broadcasting / realtime (Laravel Reverb)
###############################################################################

# `null` disables realtime. Everything still works — boards, tickets and the
# notification bell simply do not refresh by themselves, and the bell falls
# back to a slow poll. Set to `reverb` once a Reverb service is running.
BROADCAST_CONNECTION=null

# Credentials shared between the application, the websocket server and the
# browser. REVERB_APP_KEY is public (it is compiled into the JS bundle);
# REVERB_APP_SECRET is not and must never be exposed.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Where the browser connects. Locally these are 127.0.0.1 / 8080 / http;
# on Railway use the public hostname of the Reverb service with scheme=https
# and port 443.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Where the server listens. On Railway bind 0.0.0.0 and the injected $PORT.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Run the server with: php artisan reverb:start
# Broadcasts are queued, so a queue worker must also be running for realtime
# to arrive: php artisan queue:work --queue=ai,default
#
# `composer dev` starts both alongside the site, so realtime works locally as
# soon as BROADCAST_CONNECTION is set to `reverb` and the keys below are filled
# in. Remember to `npm run build` after changing them.

# Passed through to the browser bundle by Vite. These are read at build time,
# so changing them requires a rebuild (npm run build).
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

###############################################################################
# AI
###############################################################################

# Master switch. With it off, or with no API key, the application boots and
# every other feature works — AI runs are simply refused with a recorded reason.
AI_ENABLED=true

# The provider credential, as a fallback.
#
# Since AI became a global feature this is the LAST of three sources, not the
# only one: a key stored on the global AI settings screen (/admin/ai) wins over
# it, and a key on a specific board wins over that. It is still first-class —
# a deployment that has only ever set this keeps working with no database row —
# and it is the sensible thing to set for a fresh install so the AI works before
# anybody opens a settings screen.
#
# Read by App\Services\AI\AiCredentialVault and handed to the provider adapter;
# never reaches Blade, Livewire, JavaScript or a log line.
# Wanted on the web service (to queue runs and to answer chat) and on the queue
# worker (to execute them).
ANTHROPIC_API_KEY=

# Optional: a proxy or compatible gateway.
# ANTHROPIC_BASE_URL=

# --- OpenAI -----------------------------------------------------------------
#
# The second supported provider. Optional: leave the key blank and the provider
# simply cannot be selected.
#
# As with Anthropic, the global AI settings screen is the better place to put
# the key — it can be rotated without a redeploy.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=

# Which OpenAI models this workspace may choose, comma separated.
#
# Deployment-supplied on purpose: which models an account can reach is a
# property of the account, not of this application. Confirm these against the
# account that holds the key — a model it cannot reach produces a clear error
# naming this setting. No pricing or context window is claimed for them, so
# their cost reports as "not available" rather than as a guess; add rates under
# `pricing` in config/ai.php if you want figures.
AI_OPENAI_MODELS=gpt-5.1,gpt-5-mini

# Which of those ids accept an image, comma separated. Opt-in rather than
# assumed: naming an id here that turns out not to take images would fail the
# whole request rather than only the picture. Left empty, an attached image is
# described to the model in words and the attachment card says the model cannot
# see it — which is true, and fixed by switching model in the picker.
#
# The Anthropic models all accept images and need no entry here.
AI_OPENAI_VISION_MODELS=

# --- Capability mode --------------------------------------------------------
#
# observer | operator | agent — how far the AI is trusted, workspace-wide.
# See App\Enums\AiCapabilityMode.
#
#   observer  reads and answers; writes nothing, not even an internal note.
#   operator  proposes changes a person confirms, and manual suggest runs.
#   agent     also apply-mode runs (pull requests) and automatic runs.
#
# The default is `agent`, which is exactly what this product allowed before
# modes existed — so switching this feature on takes nothing away from a
# workspace already using automatic or apply runs. A fresh, cautious deployment
# should set `operator`. Whatever is set here, an administrator can tighten it
# per workspace and per board from /admin/ai, and no mode ever bypasses
# authentication, board permissions or the customer visibility rules.
AI_DEFAULT_MODE=agent

# --- Session and token limits -----------------------------------------------
#
# Defaults for the global AI settings, which are what is actually enforced.
# 0 means no limit.
#
# The session limit is context management first and cost control second: a
# conversation that has grown too large gives worse answers as well as dearer
# ones, and reaching the limit prompts the person to start a new session.
AI_SESSION_TOKEN_LIMIT=400000
# Across every session and every ticket run one person triggers, per day.
AI_DAILY_USER_TOKEN_LIMIT=2000000
# How many previous conversations the session list offers.
AI_SESSION_HISTORY=25

AI_MODEL=claude-opus-5
AI_MAX_OUTPUT_TOKENS=16000
# low | medium | high | xhigh | max
AI_EFFORT=high
# Seconds. Must be comfortably below AI_JOB_TIMEOUT.
AI_REQUEST_TIMEOUT=300
AI_MAX_RETRIES=2

# --- Queue ------------------------------------------------------------------
# AI runs take minutes, so they get their own queue. The worker must be started
# with --queue=ai (see README, Deployment) or nothing will ever execute.
AI_QUEUE=ai
AI_JOB_TRIES=3
AI_JOB_TIMEOUT=900

# --- Cost caps --------------------------------------------------------------
# Automatic runs are the runaway-cost risk. Nobody bypasses this cap — not an
# administrator, not a flag — because nobody chose those runs.
AI_DAILY_AUTO_RUN_CAP=20
AI_MAX_DAILY_AUTO_RUN_CAP=500
AI_DAILY_MANUAL_RUN_CAP=100
AI_ADMINS_BYPASS_CAP=true

# --- Isolated working directories -------------------------------------------
# Relative to storage/app. Scratch space only: every run gets its own directory
# and it is deleted when the run ends. Railway replaces the filesystem on each
# deploy, so nothing durable may live here.
AI_WORKSPACE_PATH=ai-runs
AI_KEEP_FAILED_WORKSPACES=false

# --- Repositories -----------------------------------------------------------
# Off by default. With cloning off, suggest mode still runs and says in its own
# note that it could not read the code. Turning it on requires git in the worker
# image and GITHUB_TOKEN below.
AI_REPOSITORY_CLONE_ENABLED=false
AI_GIT_BINARY=git
AI_GIT_TIMEOUT=300
AI_CLONE_DEPTH=1
AI_MAX_CONTEXT_FILES=400
AI_MAX_CONTEXT_BYTES=60000
AI_BRANCH_PREFIX=ai/
AI_COMMIT_AUTHOR_NAME="Workspace AI"
AI_COMMIT_AUTHOR_EMAIL=ai@example.invalid

# --- Apply mode code generation ---------------------------------------------
# `unavailable` (the default) means apply mode's architecture is complete but
# the step that edits files has no runtime: an apply run fails immediately with
# an internal note naming exactly what to set. Nothing is faked and no empty
# pull request is opened.
#
# Set to `claude_code` to enable it. Requires, on the QUEUE WORKER service:
#   - the Claude Code CLI in the image (or AI_CLAUDE_CODE_BINARY as a full path)
#   - ANTHROPIC_API_KEY
#   - AI_REPOSITORY_CLONE_ENABLED=true and GITHUB_TOKEN
AI_CODE_DRIVER=unavailable
AI_CLAUDE_CODE_BINARY=claude
AI_CODE_TIMEOUT=1800
# AI_CLAUDE_CODE_ARGS=

# Pipe-separated commands run inside the checkout before committing. A non-zero
# exit fails the run, so an unbuildable branch never becomes a pull request.
# These are deployment configuration, never user input.
# AI_VALIDATION_COMMANDS=composer install --no-interaction|php artisan test
AI_VALIDATION_TIMEOUT=900

# --- Workspace AI chat ------------------------------------------------------
# What a conversation is for, chosen beside Send: reading | writing | everything.
# Reading looks things up and proposes nothing; writing drafts tickets and pages
# for a person to confirm; everything does both. The default is what a new
# conversation starts in, and it is the read-only one on purpose.
AI_CHAT_DEFAULT_MODE=reading

# Which model each of those runs on. Retrieval is bounded work; drafting
# something somebody will act on is the turn worth spending on. Both ids must
# appear in the catalogue in config/ai.php, and both are still resolved against
# whichever provider the workspace is actually configured for.
AI_CHAT_READING_MODEL=claude-sonnet-5
AI_CHAT_WRITING_MODEL=claude-opus-5
AI_CHAT_EVERYTHING_MODEL=claude-opus-5

AI_CHAT_HISTORY=20
AI_CHAT_MAX_OUTPUT_TOKENS=4000
AI_CHAT_CONTEXT_TICKETS=60
AI_CHAT_CONTEXT_PAGES=40
AI_CHAT_CONTEXT_EVENTS=40

# --- What the assistant may look up -----------------------------------------
# The retrieval layer: read tools the assistant calls while answering, so a
# question like "which tickets are overdue" is answered from a query rather
# than from the summary in the prompt. See App\Services\AI\Tools.
#
# NOTHING HERE IS A SECURITY CONTROL. Every lookup runs with the ASKING PERSON
# as the viewer, through the same readers the screens use, so a tool can only
# ever return what that person could have read by clicking around. These are
# cost and latency controls; turning them off makes the assistant shallower and
# grants nobody anything.

AI_TOOLS_ENABLED=true

# Times round the loop before the model has to answer. Every round is a billed
# request, so this is the main cost control on a complicated question.
AI_TOOLS_MAX_ROUNDS=4

# Lookups in one round, and total characters of material one question may
# consume. The second is what actually protects the context window.
AI_TOOLS_MAX_CALLS=6
AI_TOOLS_MAX_CHARACTERS=60000

# --- Outside Project: external knowledge ------------------------------------
# The assistant's knowledge scope is a per-conversation choice, not a
# deployment one: the "Outside Project" checkbox beside the context selector.
# NOTHING HERE TURNS THAT ON OR OFF. A conversation with the box ticked answers
# from general knowledge as well as from the project, in every deployment, with
# no variables set.
#
# What these configure is the OPTIONAL extra: live lookup against an outside
# service, for questions about things that postdate a model's training. No
# driver ships with this application, so by default the container resolves
# App\Services\AI\Knowledge\UnavailableExternalKnowledge and the assistant says
# out loud that it could not look something up rather than guessing. That is
# the intended state.
#
# NEITHER SETTING IS A PERMISSION. The knowledge scope decides where an answer
# is sourced from, never what a person may read or change — a customer with the
# box ticked sees exactly the same boards, tickets and documents as with it
# unticked. See App\Enums\AiKnowledgeScope.
#
# To connect a provider: write a class implementing
# ExternalKnowledgeProviderInterface, add a case to the match in
# App\Providers\AppServiceProvider, and name it here.

# False guarantees no request leaves this network for a search. Outside Project
# mode keeps working; only the live lookup stops.
AI_KNOWLEDGE_ENABLED=true

# Empty means none, which is the shipped state.
AI_KNOWLEDGE_DRIVER=

# Results per lookup, and seconds to wait. Both small on purpose: external
# material shares a context window with the project's own data, and the
# fallback — answer from what you know, say the lookup failed — is a perfectly
# good answer.
AI_KNOWLEDGE_MAX_RESULTS=5
AI_KNOWLEDGE_TIMEOUT=10

# --- Spoken conversation ----------------------------------------------------
# Voice is speech-to-text, the ordinary assistant, and text-to-speech. There is
# NO CREDENTIAL HERE: it uses the workspace's existing OpenAI key (OPENAI_API_KEY
# above, or one stored on the global AI settings screen), read through
# App\Services\AI\AiCredentialVault.
#
# With no OpenAI key the control is disabled and says so, naming the remedy. It
# does not hide, and it does not pretend to listen.
#
# Recordings are never written to disk and answers are never cached: the bytes
# go straight to the vendor and the audio straight back to the person who asked.

AI_VOICE_ENABLED=true
AI_VOICE_DRIVER=openai
AI_VOICE_TRANSCRIPTION_MODEL=whisper-1
AI_VOICE_SPEECH_MODEL=gpt-4o-mini-tts

# The voices offered in the picker, comma separated. An allow-list, not a
# suggestion: the chosen value is interpolated into a vendor request and comes
# from a browser, so anything not on this list becomes the default.
AI_VOICE_VOICES=alloy,echo,fable,onyx,nova,shimmer
AI_VOICE_DEFAULT=alloy

# Seconds. Lower than the chat timeout on purpose: a spoken turn that takes two
# minutes to come back has already failed as a conversation.
AI_VOICE_TIMEOUT=120

# Requests a minute, per person, across both voice endpoints. These are the
# only AI calls a browser can make in a loop without somebody typing, and both
# are billed per request.
AI_VOICE_RATE_LIMIT=30
# --- Chat attachments -------------------------------------------------------
# Files somebody attaches to a conversation: PDF, Markdown, text, CSV, images,
# audio, and the modern Office formats.
#
# Nothing below needs setting for attachments to work. They are stored on the
# same disk as every other attachment in the product — see ATTACHMENT_DISK
# above, and the same production durability check applies — and read by the
# processors in App\Services\AI\Attachments.
#
# These limits are deliberately separate from the ticket-attachment ones. A
# ticket attachment is stored and served; one of these is stored, *read*, and
# its contents put in front of a language model. The allow-list is therefore
# narrower (no archives, no SVG) and lives in config/ai.php.

AI_ATTACHMENTS_ENABLED=true
AI_ATTACHMENT_MAX_SIZE_KB=20480
AI_ATTACHMENT_MAX_PER_SESSION=10

# Which queue reads uploaded files.
#
# Its own, and it matters where that queue is CONSUMED. Reading an attachment
# means opening the file the upload just wrote, and with ATTACHMENT_DISK=volume
# that file only exists on the service that wrote it — a Railway volume attaches
# to one service, so `volume` is a different filesystem in every container that
# mounts one. A worker on another service finds nothing there, and a missing
# object is a legitimate condition rather than an error, so the upload succeeds
# and then reports itself unreadable with nothing in the log.
#
# So the web container runs a worker for exactly this queue (see
# docker/supervisord.conf) and the separate worker service does NOT listen to
# it. Do not add `attachments` to that service's --queue list while the disk is
# a volume: two workers would race and the one that cannot see the file would
# win half the time.
#
# With ATTACHMENT_DISK=s3 the constraint disappears — any worker can read a
# bucket. Set this to `default` then, add it to the worker service, and drop the
# program from supervisord if you would rather keep one worker.
AI_ATTACHMENTS_QUEUE=attachments

# How much extracted text may reach the model. Characters rather than tokens,
# because characters are what can be counted exactly; the token figure the UI
# shows is derived from these and is labelled an estimate.
#
# `TOTAL` is the figure that actually protects the context window: it caps every
# attachment in one conversation put together. `DIGEST` is how much of a
# document survives into the summary sent on later turns — a file's full text
# goes in once, and after that it is referenced rather than re-sent.
AI_ATTACHMENT_FILE_CHARS=40000
AI_ATTACHMENT_TOTAL_CHARS=120000
AI_ATTACHMENT_DIGEST_CHARS=1200

# Spreadsheets. The column profile (sums, means, ranges, outliers) is computed
# over EVERY row by App\Services\AI\Attachments\CsvAnalyser; this only limits
# how many rows are quoted to the model as a sample, and the prompt says which
# is which so a total is never derived from the sample.
AI_ATTACHMENT_CSV_ROWS=300

# Images are decoded and re-encoded before they are sent, which strips EXIF —
# including the GPS coordinates a phone photograph carries. The box is the point
# at which more pixels stop buying accuracy and start buying tokens.
AI_ATTACHMENT_IMAGE_MAX_DIMENSION=1568

# Audio transcription. OPTIONAL, and the only part of attachments that needs a
# credential: it uses the OpenAI key configured above (or stored in the global
# AI settings), because transcription is a different endpoint from chat.
#
# With no OpenAI key, a recording is still stored and its card says that
# transcription is not configured and who can configure it. It does not fail
# and it does not silently do nothing.
AI_ATTACHMENT_AUDIO_ENABLED=true
AI_TRANSCRIPTION_MODEL=whisper-1
AI_TRANSCRIPTION_TIMEOUT=180

###############################################################################
# GitHub
###############################################################################
#
# Two features share one credential: apply mode pushes a branch and opens a
# pull request (outbound), and the webhook links branches, commits and pull
# requests to tickets (inbound). Both are off until configured.
#
# The token needs exactly two permissions on the repositories in scope and
# nothing else:
#   contents: write        push a branch
#   pull_requests: write   open a pull request
# It is deliberately never given merge rights: PullRequestClient has no merge
# method, so apply mode could not merge even if the token allowed it.
#
# Read by App\Services\GitHub and by nothing else. Never reaches Blade,
# Livewire, JavaScript or a log line.

GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_REQUEST_TIMEOUT=20

# --- Webhook ----------------------------------------------------------------
# The shared secret configured on the GitHub webhook. Every delivery is signed
# with it as X-Hub-Signature-256 and verified against the raw request body.
#
# WITH NO SECRET SET, EVERY DELIVERY IS REJECTED. That is deliberate: an
# endpoint that accepts unsigned input is an unauthenticated write into ticket
# history. Generate one with: openssl rand -hex 32
#
# Point the GitHub webhook at:  https://your-app.example/webhooks/github
# Content type: application/json. Events: pushes, branch/tag creation,
# pull requests, check suites, statuses.
GITHUB_WEBHOOK_SECRET=

GITHUB_WEBHOOK_RETENTION_DAYS=30
GITHUB_WEBHOOK_RATE_LIMIT=300
GITHUB_QUEUE=default
GITHUB_JOB_TRIES=3
GITHUB_JOB_TIMEOUT=60

# How many ticket references one delivery may link, and how many commits of a
# push are examined. Bounds the work a single large merge can create.
GITHUB_MAX_REFERENCES=50
GITHUB_MAX_COMMITS=20

###############################################################################
# Slack notifications
###############################################################################
#
# Configured PER BOARD, on /boards/{board}/integrations — each board posts to
# its own channel, because each board belongs to a different customer. The
# webhook URL is stored encrypted on the board, not here.
#
# This switch only decides whether the deployment may post at all. Turn it off
# on a staging environment restored from a production database dump, or it will
# start posting into the real team's channel within minutes of booting.

SLACK_NOTIFICATIONS_ENABLED=true
SLACK_QUEUE=default
SLACK_TIMEOUT=8
SLACK_TRIES=3

###############################################################################
# Critical ticket SMS
###############################################################################
#
# One trigger only: a ticket raised at Critical priority. Off by default.

SMS_ENABLED=false

# unavailable | log | 46elks
#   unavailable  refuses and records why. Nothing is faked.
#   log          writes to the application log and records status `logged`,
#                never `sent`. Local development only.
#   46elks       the real provider.
SMS_DRIVER=unavailable

# Alphanumeric sender ID (max 11 characters, no spaces) or an E.164 number.
# Several networks reject alphanumeric senders; check for the countries the
# on-call numbers are in.
SMS_FROM=Aqueduct

# 46elks API credentials from https://46elks.com/ (Account → API keys).
SMS_46ELKS_USERNAME=
SMS_46ELKS_PASSWORD=
SMS_46ELKS_ENDPOINT=https://api.46elks.com/a1/sms
# SMS_46ELKS_DLR_URL=

# Fallback on-call numbers, comma separated, in full international form. A
# board can override these with its own rota on the integrations screen.
SMS_ALERT_RECIPIENTS=
SMS_MAX_RECIPIENTS=5

# One alert per ticket per number is guaranteed by a unique index. This is the
# second, coarser guard: a script filing forty critical tickets rings the phone
# once. Seconds; 0 disables.
SMS_BOARD_COOLDOWN=300

SMS_QUEUE=default
SMS_TRIES=3
SMS_TIMEOUT=15
SMS_MAX_LENGTH=300

# Delivery records hold phone numbers, so they are pruned rather than kept for
# ever. Removed by `php artisan workspace:prune`, scheduled daily.
SMS_RETENTION_DAYS=90

###############################################################################
# Seeding
###############################################################################

# Used by `php artisan db:seed`. A password MUST be supplied outside local
# development: AdminUserSeeder refuses to fall back otherwise.
SEED_ADMIN_NAME="Workspace Admin"
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=

SEED_TEAM_NAME="Team Member"
